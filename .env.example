# ===== 大模型 =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 嵌入 =====
# chroma_default（轻量、无需 torch，默认）/ local_bge（中文友好，需 pip install -e .[bge]）
EMBEDDING_PROVIDER=chroma_default
BGE_MODEL=BAAI/bge-small-zh-v1.5

# ===== 数据源 =====
# mock（本地 SQLite）/ warehouse（数仓，需实现 warehouse_source）
DATA_SOURCE=mock
SQLITE_PATH=data/mock.sqlite
UPLOAD_DIR=data/uploads

# ===== 向量库 =====
VECTOR_STORE=chroma
CHROMA_PATH=data/chroma

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

# ===== 可观测 =====
LANGSMITH_TRACING=false
