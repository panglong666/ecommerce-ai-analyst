# ===== 大模型 =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 嵌入 =====
# chroma_default（轻量、无需 torch，默认）/ local_bge（中文友好，需 pip install -e .[bge]）
EMBEDDING_PROVIDER=chroma_default
BGE_MODEL=BAAI/bge-small-zh-v1.5

# ===== 数据源 =====
# mock（本地 SQLite）/ warehouse（数仓，需实现 warehouse_source）
DATA_SOURCE=mock
SQLITE_PATH=data/mock.sqlite
UPLOAD_DIR=data/uploads
# 知识库「策划语料」子目录：reindex / 种子文档 / 上传落点共用；改名即换目录（默认 docs）
DOCS_SUBDIR=docs

# ===== 向量库 =====
VECTOR_STORE=chroma
CHROMA_PATH=data/chroma

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

# ===== 安全（可选，公网 / 企业部署建议配置）=====
# 留空 = 演示模式放行；填写后所有 API 请求需带 X-API-Key 头
API_KEY=
# CORS 白名单，逗号分隔。默认仅本机前端；公网部署请改为前端真实域名
CORS_ORIGINS=http://127.0.0.1:8000

# ===== 可观测 =====
LANGSMITH_TRACING=false
